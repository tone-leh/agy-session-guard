{
  "name": "agy-sag",
  "version": "1.5.1",
  "description": "agy-Sag (Antigravity Superpower & Agent Guard) — Modular Zero-ASAR CDP deep-enhancement suite for Google Antigravity 2.0: 10-language native UI translation, auto /compact guard, prompt queue, draft vault, turn bookmarks, policy-gated auto-accept, optical theme studio, read-only quota pulse & storage doctor. Zero runtime dependencies, MIT licensed.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agy-sag": "./cli/sag-cli.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "antigravity",
    "agy-sag",
    "agy-nov",
    "antigravity-i18n",
    "antigravity-localization",
    "context-compaction",
    "prompt-queue",
    "safe-auto-accept",
    "theme-studio",
    "quota-pulse",
    "zero-asar",
    "cdp-suite"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "workbench": "node workbench/server.mjs",
    "workbench:smoke": "node workbench/server.mjs --smoke",
    "attach": "node cli/cdp-attach.mjs --attach",
    "watch": "node cli/watch-daemon.mjs",
    "doctor": "node cli/doctor.mjs",
    "storage": "node cli/storage-doctor.mjs audit",
    "i18n:import": "node scripts/i18n/import-upstream.mjs",
    "i18n:build-ext": "node scripts/i18n/build-ext-packs.mjs",
    "i18n:validate": "node cli/sag-cli.mjs i18n validate",
    "launch": "node cli/sag-cli.mjs launch",
    "keepalive": "node cli/sag-cli.mjs keepalive",
    "install:plugin": "node cli/install-plugin.mjs",
    "remove": "node cli/cdp-attach.mjs --remove",
    "status": "node cli/cdp-attach.mjs --status"
  }
}
